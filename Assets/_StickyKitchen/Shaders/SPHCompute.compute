#pragma kernel ComputeDensityPressure
#pragma kernel ComputeForces
#pragma kernel Integrate

struct Particle
{
    float pressure;
    float density;
    float3 currentForce;
    float3 velocity;
    float3 position;
};

RWStructuredBuffer<Particle> _particles;

int particleLength;

float particleMass;
float viscosity;
float gasConstant;
float restDensity;
float boundDamping;

float radius;
float smoothingRadius;
float cohesionRadius;
float cohesionStrength;

float linearDamping;
float groundFriction;
float maxAcceleration;
float timestep;

float3 gravity;
float3 boxCenter;
float3 boxSize;
float3 spherePos;
float sphereRadius;

static const float PI = 3.14159265359;

[numthreads(100, 1, 1)]
void ComputeDensityPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    float h = smoothingRadius;
    float h2 = h * h;
    float h3 = h2 * h;

    float density = 0;
    float3 position = _particles[id.x].position;

    for (int j = 0; j < particleLength; j++)
    {
        float3 delta = position - _particles[j].position;
        float distanceSquared = dot(delta, delta);

        if (distanceSquared >= h2)
            continue;

        float q = 1.0 - distanceSquared / h2;
        density += particleMass * 315.0 / (64.0 * PI * h3) * q * q * q;
    }

    density = max(density, 0.000001);

    _particles[id.x].density = density;
    _particles[id.x].pressure = gasConstant * max(density - restDensity, 0.0);
}

[numthreads(100, 1, 1)]
void ComputeForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    Particle current = _particles[id.x];

    float h = smoothingRadius;
    float h2 = h * h;
    float h4 = h2 * h2;
    float h5 = h4 * h;

    float densityI = max(current.density, 0.000001);
    float3 acceleration = gravity;

    for (int j = 0; j < particleLength; j++)
    {
        if (j == (int) id.x)
            continue;

        Particle other = _particles[j];

        float3 delta = current.position - other.position;
        float distanceSquared = dot(delta, delta);

        if (distanceSquared <= 0.0000000001)
            continue;

        float distanceToOther = sqrt(distanceSquared);
        float3 direction = delta / distanceToOther;

        // Presion y viscosidad dentro del mismo soporte.
        if (distanceToOther < h)
        {
            float q = 1.0 - distanceToOther / h;
            float densityJ = max(other.density, 0.000001);

            float gradient = -45.0 / (PI * h4) * q * q;
            float pressureTerm = current.pressure / (densityI * densityI) + other.pressure / (densityJ * densityJ);

            acceleration -= particleMass * pressureTerm * gradient * direction;

            float laplacian = 45.0 / (PI * h5) * q;
            acceleration += viscosity * particleMass / densityJ * (other.velocity - current.velocity) * laplacian;
        }

        // Atraccion local aproximada para conservar el charco.
        // Deja de atraer cuando las particulas ya estan suficientemente cerca.
        if (distanceToOther < cohesionRadius)
        {
            float q = 1.0 - distanceToOther / cohesionRadius;
            float stretch = max(distanceToOther - radius * 2.0, 0.0) / cohesionRadius;

            acceleration -= cohesionStrength * q * q * stretch * direction;
        }
    }

    float accelerationLength = length(acceleration);

    if (accelerationLength > maxAcceleration)
    {
        acceleration *= maxAcceleration / accelerationLength;
    }

    _particles[id.x].currentForce = acceleration * particleMass;
}

void ResolveAxis(inout float position, inout float velocity, float minimum, float maximum, float bounce)
{
    if (position < minimum)
    {
        position = minimum;

        if (velocity < 0)
            velocity = -velocity * bounce;
    }

    if (position > maximum)
    {
        position = maximum;

        if (velocity > 0)
            velocity = -velocity * bounce;
    }
}

[numthreads(100, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    Particle particle = _particles[id.x];

    float3 velocity = particle.velocity + particle.currentForce / particleMass * timestep;
    velocity *= exp(-linearDamping * timestep);

    float3 position = particle.position + velocity * timestep;

    float bounce = saturate(abs(boundDamping));
    float3 minimum = boxCenter - boxSize * 0.5 + radius;
    float3 maximum = boxCenter + boxSize * 0.5 - radius;

    if (sphereRadius > 0)
    {
        float3 delta = position - spherePos;
        float distanceToSphere = length(delta);
        float contactRadius = sphereRadius + radius;

        if (distanceToSphere < contactRadius)
        {
            float3 normal = distanceToSphere > 0.00001 ? delta / distanceToSphere : float3(0, 1, 0);

            position = spherePos + normal * contactRadius;

            float inwardSpeed = dot(velocity, normal);

            if (inwardSpeed < 0)
            {
                velocity -= normal * inwardSpeed * (1.0 + bounce);
            }
        }
    }

    ResolveAxis(position.x, velocity.x, minimum.x, maximum.x, bounce);
    ResolveAxis(position.y, velocity.y, minimum.y, maximum.y, bounce);
    ResolveAxis(position.z, velocity.z, minimum.z, maximum.z, bounce);

    // Frenado tangencial al descansar sobre la base.
    if (position.y <= minimum.y + 0.0001)
    {
        velocity.xz *= exp(-groundFriction * timestep);
    }

    _particles[id.x].position = position;
    _particles[id.x].velocity = velocity;
}