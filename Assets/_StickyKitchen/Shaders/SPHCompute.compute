#pragma kernel Integrate
#pragma kernel ComputeForces
#pragma kernel ComputeDensityPressure

struct Particle
{
    float pressure;
    float density;
    float3 currentForce;
    float3 velocity;
    float3 position;
};

RWStructuredBuffer<Particle> _particles;

int particleLength;
float particleMass;
float viscosity;
float gasConstant;
float restDensity;
float boundDamping;
float pi;
float timestep;

float radius;
float radius2;
float radius3;
float radius4;
float radius5;

float3 boxSize;
float3 spherePos;
float sphereRadius;

// Kernel Poly6 para densidad
float StdKernel(float dist2)
{
    float val = radius2 - dist2;
    return (315.0 / (64.0 * pi * radius3)) * val * val * val;
}

// Kernel Spiky (Gradiente) para presión
float SpikyKernelGrad(float dist)
{
    return -45.0 / (pi * radius4) * pow(radius - dist, 2);
}

// Kernel Spiky (Segunda Derivada) para viscosidad
float SpikyKernelSecondDeriv(float dist)
{
    return 45.0 / (pi * radius5) * (radius - dist);
}

[numthreads(100, 1, 1)]
void ComputeDensityPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    float sum = 0.0;
    for (int j = 0; j < particleLength; j++)
    {
        float3 delta = _particles[j].position - _particles[id.x].position;
        float r2 = dot(delta, delta);

        if (r2 < radius2)
        {
            sum += StdKernel(r2 * 0.004);
        }
    }

    _particles[id.x].density = sum * particleMass + 0.0001;
    _particles[id.x].pressure = gasConstant * (_particles[id.x].density - restDensity);
}

[numthreads(100, 1, 1)]
void ComputeForces(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    float3 pressureForce = float3(0, 0, 0);
    float3 viscosityForce = float3(0, 0, 0);

    for (int j = 0; j < particleLength; j++)
    {
        if (id.x == (uint) j)
            continue;

        float3 delta = _particles[j].position - _particles[id.x].position;
        float dist = length(delta);

        if (dist < radius && dist > 0)
        {
            float3 dir = normalize(delta);

            // Fuerza de presión
            pressureForce += dir * SpikyKernelGrad(dist) * (_particles[id.x].pressure + _particles[j].pressure) / (2.0 * _particles[j].density);

            // Fuerza de viscosidad
            viscosityForce += viscosity * (_particles[j].velocity - _particles[id.x].velocity) * SpikyKernelSecondDeriv(dist) / _particles[j].density;
        }
    }

    float3 gravity = float3(0, -9.81, 0) * _particles[id.x].density;
    _particles[id.x].currentForce = gravity - pressureForce + viscosityForce;

    // Colisión opcional con Esfera
    if (sphereRadius > 0)
    {
        float3 sphereDelta = _particles[id.x].position - spherePos;
        float sphereDist = length(sphereDelta);
        if (sphereDist < sphereRadius)
        {
            float3 pushDir = normalize(sphereDelta);
            _particles[id.x].currentForce += pushDir * 300.0 * (sphereRadius - sphereDist);
        }
    }
}

[numthreads(100, 1, 1)]
void Integrate(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint) particleLength)
        return;

    // Integración de Euler
    _particles[id.x].velocity += timestep * (_particles[id.x].currentForce / _particles[id.x].density);
    _particles[id.x].position += timestep * _particles[id.x].velocity;

    // Límites de la caja
    float3 halfBox = boxSize * 0.5;

    if (abs(_particles[id.x].position.x) > halfBox.x)
    {
        _particles[id.x].position.x = sign(_particles[id.x].position.x) * halfBox.x;
        _particles[id.x].velocity.x *= boundDamping;
    }
    if (abs(_particles[id.x].position.y) > halfBox.y)
    {
        _particles[id.x].position.y = sign(_particles[id.x].position.y) * halfBox.y;
        _particles[id.x].velocity.y *= boundDamping;
    }
    if (abs(_particles[id.x].position.z) > halfBox.z)
    {
        _particles[id.x].position.z = sign(_particles[id.x].position.z) * halfBox.z;
        _particles[id.x].velocity.z *= boundDamping;
    }
}